  }
  const seq = {};
  out.slice(1).forEach(r => {
    const id = String(r[0]).trim(); if (id) { seq[id] = (seq[id] || 0) + 1; r[col('排序')] = seq[id]; }
    if (String(r[col('單元名稱')]).trim() === '銅箔發光卡片' && r[col('上課時間')] !== '180分鐘') { r[col('上課時間')] = '180分鐘'; log.push('銅箔發光卡片 180 分鐘'); }
  });
  units.getRange(1, 1, out.length, W).setValues(out);

  // ── 方案分頁：STEAM創意實驗室第 2 天課表
  const pv = packs.getDataRange().getValues(), sc = pv[0].indexOf('課程表');
  for (let r = 1; r < pv.length; r++) {
    const s = String(pv[r][sc]);
    if (s.includes(OLD)) { packs.getRange(r + 1, sc + 1).setValue(s.replace('09:00 ' + OLD + '；10:40 ' + OLD, '09:00 神奇平衡鳥；10:40 蝕刻鑰匙圈').split(OLD).join('神奇平衡鳥')); log.push(pv[r][0] + ' 課表'); }
  }

  // ── 新分頁：單元總表、分齡課表
  [['單元總表', CATALOG, [150, 170, 70, 70, 70, 70, 360, 180, 160, 160, 140, 200]], ['分齡課表', PLAN, [140, 50, 150, 150, 150, 150, 150, 150]]].forEach(([name, data, widths]) => {
    if (ss.getSheetByName(name)) return;
    const sh = ss.insertSheet(name);
    sh.getRange(1, 1, data.length, data[0].length).setValues(data);
    sh.setFrozenRows(1);
    sh.getRange(1, 1, 1, data[0].length).setFontWeight('bold').setBackground('#1D4C58').setFontColor('#ffffff');
    widths.forEach((w, i) => sh.setColumnWidth(i + 1, w));
    log.push('新增「' + name + '」分頁（' + (data.length - 1) + ' 列）');
  });
  CacheService.getScriptCache().remove('courses-json');
  Logger.log('完成：' + (log.join('、') || '已經是最新的了'));
}
