/**
 * WeClass 課程後台（Google Apps Script，綁定在「WeClass 課程資料庫」試算表）
 *
 * 功能
 *  1. 試算表上方選單「WeClass 課程後台」→「開啟課程後台」：在試算表裡打開後台介面（Admin.html）。
 *     只有能編輯這份試算表的 Google 帳號才打得開，所以「誰能管理課程」= 試算表的共用設定。
 *  2. 部署成「網頁應用程式」後，網址會回傳所有「上架」課程的 JSON，課程網站讀這個網址顯示課程。
 *  3. 後台上傳的照片存到雲端硬碟「WeClass 課程照片」資料夾，並設成知道連結的人可檢視，網站才能顯示。
 *
 * 資料表
 *  「方案」：一列一個課程方案。「網址代稱」是課程頁網址的英文名稱（例如 little-astronomer → weclass.tw/courses/little-astronomer/），上線後不要再改。學習成果一行一項「標題｜說明」；課程表一行一天「第 1 天｜09:00 單元一；10:40 單元二」；課程需求一行一項。
 *  「分齡」填 低年級、中年級、高年級（可多個，用頓號分隔），決定方案出現在網站「系統分齡課程包」的哪一格。
 *  「單元」：一列一個單元，用「方案編號」對應到方案（空白＝還沒放進主題，網站暫不顯示），「排序」決定單元順序。標籤用頓號「、」分隔。
 */

const SHEET_PACKS = '方案';
const SHEET_UNITS = '單元';
const PHOTO_FOLDER = 'WeClass 課程照片';
const CACHE_KEY = 'courses-json';
const WORLD_KEYS = ['sci', 'eng', 'tech', 'art'];

const PACK_HEAD = ['方案編號', '上架', '排序', '方案名稱', '類型', '適合年級', '方案介紹', '封面照片', '學習成果', '課程表', '課程需求', '網址代稱', '分齡'];
const UNIT_HEAD = ['方案編號', '排序', '單元名稱', '上課時間', '單元說明', '科學知識', '技能訓練', '科學標籤', '工程標籤', '科技標籤', '藝術標籤', '單元照片', '分齡'];

/* ── 選單 ─────────────────────────────────────────── */
function onOpen() {
  SpreadsheetApp.getUi().createMenu('WeClass 課程後台')
    .addItem('開啟課程後台', 'openAdmin')
    .addSeparator()
    .addItem('初始化資料表（第一次使用）', 'setup')
    .addToUi();
}

function openAdmin() {
  const html = HtmlService.createHtmlOutputFromFile('Admin').setWidth(1320).setHeight(860);
  SpreadsheetApp.getUi().showModalDialog(html, 'WeClass 課程後台');
}

/* ── 第一次使用：建立「方案」「單元」兩個分頁並放入現有 11 個方案 ── */
function setup() {
  const ss = SpreadsheetApp.getActive();
  const seed = SEED_DATA;
  let units = ss.getSheetByName(SHEET_UNITS);
  if (!units) {
    const first = ss.getSheets()[0];
    if (first && String(first.getRange(1, 1).getValue()) === '方案編號' && String(first.getRange(1, 3).getValue()) === '單元名稱') {
      first.setName(SHEET_UNITS); units = first;          // 試算表本來就有單元資料（由 CSV 匯入）
    } else {
      units = ss.insertSheet(SHEET_UNITS);
      writeTable_(units, seed.units);
    }
  }
  let packs = ss.getSheetByName(SHEET_PACKS);
  if (!packs) { packs = ss.insertSheet(SHEET_PACKS, 0); writeTable_(packs, seed.packs); }
  styleSheet_(packs, [90, 50, 50, 170, 60, 90, 320, 200, 320, 320, 320, 180, 140]);
  styleSheet_(units, [90, 50, 170, 110, 300, 220, 220, 200, 200, 200, 200, 200, 140]);
  ss.getSheets().forEach(sh => { if (sh.getName() !== SHEET_PACKS && sh.getName() !== SHEET_UNITS && sh.getLastRow() === 0) ss.deleteSheet(sh); });
  CacheService.getScriptCache().remove(CACHE_KEY);
  SpreadsheetApp.getUi().alert('完成！之後從上方選單「WeClass 課程後台 › 開啟課程後台」管理課程。');
}

function writeTable_(sh, rows) {
  sh.clear();
  sh.getRange(1, 1, rows.length, rows[0].length).setNumberFormat('@').setValues(rows.map(r => r.map(v => v === null || v === undefined ? '' : String(v))));
}
function styleSheet_(sh, widths) {
  sh.setFrozenRows(1);
  const lastCol = Math.max(sh.getLastColumn(), widths.length);
  sh.getRange(1, 1, 1, lastCol).setFontWeight('bold').setBackground('#E1F6F4').setFontColor('#1D4C58');
  widths.forEach((w, i) => sh.setColumnWidth(i + 1, w));
  if (sh.getLastRow() > 1) sh.getRange(2, 1, sh.getLastRow() - 1, lastCol).setVerticalAlignment('top').setWrap(true);
}

/* ── 讀取：把兩個分頁轉成網站用的資料格式 ── */
function readCourses_(includeHidden) {
  const ss = SpreadsheetApp.getActive();
  const packSh = ss.getSheetByName(SHEET_PACKS), unitSh = ss.getSheetByName(SHEET_UNITS);
  if (!packSh || !unitSh) throw new Error('找不到「方案」或「單元」分頁，請先執行「初始化資料表」。');
  const packs = packSh.getDataRange().getDisplayValues().slice(1).filter(r => r[0]);
  const units = unitSh.getDataRange().getDisplayValues().slice(1).filter(r => r[0] && r[2]);
  const LV = ['低年級', '中年級', '高年級'];
  const lines = s => String(s || '').split(/\r?\n/).map(x => x.trim()).filter(Boolean);
  const tags = s => String(s || '').split(/[、,，]/).map(x => x.trim()).filter(Boolean);
  return packs
    .map(r => ({
      id: r[0].trim().toLowerCase(),
      published: r[1].trim() !== '否',
      order: Number(r[2]) || 999,
      title: r[3], type: r[4] === '進階' ? '進階' : '初階', grades: r[5], desc: r[6], intro_image: r[7],
      outcomes: lines(r[8]).map(l => { const [title, ...d] = l.split('｜'); return { title: title.trim(), desc: d.join('｜').trim() }; }),
      schedule: lines(r[9]).map(l => { const [day, ...d] = l.split('｜'); return { day: day.trim(), items: d.join('｜').split('；').map(x => x.trim()).filter(Boolean) }; }),
      requirements: lines(r[10]),
      levels: tags(r[12]).filter(x => LV.includes(x)),
      slug: String(r[11] || '').trim().toLowerCase().replace(/[^a-z0-9-]+/g, '-').replace(/^-|-$/g, ''),
      units: units.filter(u => u[0].trim().toLowerCase() === r[0].trim().toLowerCase())
        .sort((a, b) => (Number(a[1]) || 0) - (Number(b[1]) || 0))
        .map((u, i) => ({
          id: r[0].trim().toLowerCase() + 'u' + (i + 1), title: u[2], duration: u[3] || '90分鐘', desc: u[4], sci_desc: u[5], skill_desc: u[6],
          sci: tags(u[7]), eng: tags(u[8]), tech: tags(u[9]), art: tags(u[10]), img: u[11], levels: tags(u[12]).filter(x => LV.includes(x))
        }))
    }))
    .filter(p => includeHidden || (p.published && p.units.length))
    .sort((a, b) => a.order - b.order);
}

/* 還沒放進主題的單元（方案編號空白或對不到方案） */
function readLoose_() {
  const ss = SpreadsheetApp.getActive();
  const packSh = ss.getSheetByName(SHEET_PACKS), unitSh = ss.getSheetByName(SHEET_UNITS);
  const ids = new Set(packSh.getDataRange().getDisplayValues().slice(1).map(r => r[0].trim().toLowerCase()).filter(Boolean));
  const tags = s => String(s || '').split(/[、,，]/).map(x => x.trim()).filter(Boolean);
  return unitSh.getDataRange().getDisplayValues().slice(1).filter(u => u[2] && !ids.has(String(u[0]).trim().toLowerCase()))
    .map(u => ({ title: u[2], duration: u[3] || '90分鐘', desc: u[4], sci_desc: u[5], skill_desc: u[6], sci: tags(u[7]), eng: tags(u[8]), tech: tags(u[9]), art: tags(u[10]), img: u[11], levels: tags(u[12]) }));
}

/* 後台讀資料（google.script.run 呼叫） */
function getCourses() { return { courses: readCourses_(true), loose: readLoose_() }; }

/* 後台按「發布到網站」：整份覆寫兩個分頁 */
function saveCourses(courses, loose) {
  if (!Array.isArray(courses)) throw new Error('資料格式不正確');
  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  try {
    const ss = SpreadsheetApp.getActive();
    const join = a => (a || []).join('、');
    const packRows = [PACK_HEAD], unitRows = [UNIT_HEAD];
    courses.forEach((p, pi) => {
      const id = String(p.id || ('p' + (pi + 1))).toUpperCase();
      packRows.push([id, p.published === false ? '否' : '是', pi + 1, p.title || '', p.type || '初階', p.grades || '', p.desc || '', p.intro_image || '',
        (p.outcomes || []).map(o => o.title + '｜' + o.desc).join('\n'),
        (p.schedule || []).map(d => d.day + '｜' + (d.items || []).join('；')).join('\n'),
        (p.requirements || []).join('\n'), p.slug || '', join(p.levels)]);
      (p.units || []).forEach((u, ui) => unitRows.push([id, ui + 1, u.title || '', u.duration || '90分鐘', u.desc || '', u.sci_desc || '', u.skill_desc || '',
        join(u.sci), join(u.eng), join(u.tech), join(u.art), u.img || '', join(u.levels)]));
    });
    (loose || []).forEach((u, ui) => { if (u.title) unitRows.push(['', ui + 1, u.title, u.duration || '90分鐘', u.desc || '', u.sci_desc || '', u.skill_desc || '',
      join(u.sci), join(u.eng), join(u.tech), join(u.art), u.img || '', join(u.levels)]); });
    writeTable_(ss.getSheetByName(SHEET_PACKS), packRows);
    writeTable_(ss.getSheetByName(SHEET_UNITS), unitRows);
    styleSheet_(ss.getSheetByName(SHEET_PACKS), []);
    styleSheet_(ss.getSheetByName(SHEET_UNITS), []);
    CacheService.getScriptCache().remove(CACHE_KEY);
    return { ok: true, packs: packRows.length - 1, units: unitRows.length - 1, loose: (loose || []).filter(u => u.title).length, at: new Date().toISOString() };
  } finally { lock.releaseLock(); }
}

/* 後台上傳照片：存到雲端硬碟，回傳網站可用的圖片網址 */
function uploadPhoto(dataUrl, name) {
  const m = String(dataUrl).match(/^data:(image\/[\w+.-]+);base64,(.+)$/);
  if (!m) throw new Error('只能上傳圖片檔');
  const folders = DriveApp.getFoldersByName(PHOTO_FOLDER);
  const folder = folders.hasNext() ? folders.next() : DriveApp.createFolder(PHOTO_FOLDER);
  const file = folder.createFile(Utilities.newBlob(Utilities.base64Decode(m[2]), m[1], name || ('photo-' + Date.now())));
  file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
  return 'https://drive.google.com/thumbnail?id=' + file.getId() + '&sz=w1600';
}

/* ── 網站讀資料：部署成網頁應用程式後的網址 ── */
function doGet() {
  const cache = CacheService.getScriptCache();
  let json = cache.get(CACHE_KEY);
  if (!json) {
    const courses = readCourses_(false).map(p => { const c = Object.assign({}, p); delete c.published; delete c.order; return c; });
    json = JSON.stringify({ updated: new Date().toISOString(), courses: courses });
    if (json.length < 95000) cache.put(CACHE_KEY, json, 300);   // 快取 5 分鐘；後台發布時會清掉
  }
  return ContentService.createTextOutput(json).setMimeType(ContentService.MimeType.JSON);
}

